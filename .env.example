# ============================================================
# Turnazo — variables de entorno
# Copiar a .env.local y completar con valores reales.
# NUNCA commitear .env.local
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Mercado Pago ---
# ID de la aplicación marketplace (cuenta del creador de la plataforma)
MP_APP_ID=
MP_APP_SECRET=
# Porcentaje de comisión de la plataforma (0 = sin comisión)
PLATFORM_FEE_PERCENT=0
# Secret para validar la firma de webhooks de MP
MP_WEBHOOK_SECRET=

# --- Web Push (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@turnazo.app

# --- Sentry ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
