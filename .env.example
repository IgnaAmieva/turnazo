# ============================================================
# Turnazo — variables de entorno
# Copiar a .env.local y completar con valores reales.
# NUNCA commitear .env.local
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Mercado Pago (Fase 6) ---
# Credenciales de la aplicación de Turnazo en el panel de desarrolladores de MP
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# URL de callback OAuth registrada en la app de MP: https://<dominio>/api/mp/oauth/callback
MP_REDIRECT_URI=http://localhost:3001/api/mp/oauth/callback
# Secreto para firmar el `state` del OAuth (cualquier string largo aleatorio)
MP_STATE_SECRET=
# 32 bytes en hex (64 caracteres): clave AES-256-GCM para cifrar los tokens de los dueños en mp_accounts
MP_TOKEN_ENCRYPTION_KEY=
# Clave secreta del webhook (panel de MP → Webhooks); sin esto /api/mp/webhook responde 500
MP_WEBHOOK_SECRET=
# Solo para probar en sandbox: "true" manda test_token: true al pedir y renovar
# tokens OAuth, así la conexión del dueño queda con credenciales de prueba.
# En producción real NO se define; al sacarla, los dueños tienen que reconectar MP.
# MP_OAUTH_TEST_MODE=true
# Porcentaje de comisión de la plataforma (0 = sin comisión)
PLATFORM_FEE_PERCENT=0

# --- Cron de push y de reintento de devoluciones ---
# Mismo valor que el secreto `push_secret` de Vault (lo usan /api/push/send y /api/mp/refund-retry)
PUSH_SEND_SECRET=

# --- Web Push (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@turnazo.app

# --- Sentry ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
